{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manifesto-md",
  "compatibility_date": "2026-10-25",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "manifesto.md", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
