---
import Base from '../../layouts/Base.astro';
import { bundles } from '../../lib/catalog';
const all = await bundles();
---
<Base title="Bundles on manifesto.md" description="Documents adopted together, as reading orders." path="/bundles/">
  <main id="main" class="wrap">
    <h1>Bundles</h1>
    <p class="lede">Documents adopted together, in reading order.</p>
    <ul class="bundles">{all.map((b) => <li class="bcard"><h3><a href={`/bundles/${b.id}/`}>{b.data.name}</a></h3><p>{b.data.line}</p><span class="n">{b.data.members.length} documents</span></li>)}</ul>
  </main>
</Base>
