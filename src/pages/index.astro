---
import Base from '../layouts/Base.astro';
import DocCard from '../components/DocCard.astro';
import { catalog, bundles, bundlesOf, searchIndex } from '../lib/catalog';
const entries = await catalog();
const allBundles = await bundles();
const shelves = [
  { key: 'specification', title: 'Specifications and protocols', filter: (e: any) => e.data.kind === 'specification' },
  { key: 'convention', title: 'Conventions', filter: (e: any) => e.data.kind === 'convention' },
  { key: 'company', title: 'Corporate principles', filter: (e: any) => !['specification', 'convention'].includes(e.data.kind) && e.data.publisher === 'company' },
  { key: 'community', title: 'Manifestos and principles', filter: (e: any) => !['specification', 'convention'].includes(e.data.kind) && e.data.publisher !== 'company' },
];
const index = searchIndex(entries, allBundles);
const claimedCount = entries.filter((e) => e.data.listing === 'claimed').length;
---
<Base title="manifesto.md: the documents projects stand on" description={`${entries.length} manifestos, principles, specifications and conventions, each linking to its canonical text.`}>
  <main id="main" class="wrap">
    <section class="hero">
      <h1>The documents projects stand on.</h1>
      <p class="lede">{entries.length} manifestos, principles, specifications and conventions. Canonical text, version read against, the bundles they travel in.</p>
      <form class="search" role="search" action="/" data-search>
        <label class="sr" for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="Search by name, tenet, maintainer or bundle" autocomplete="off" />
      </form>
      <ul class="filters" data-filters aria-label="Filter by kind">
        <li><button type="button" data-kind="" aria-pressed="true">All</button></li>
        <li><button type="button" data-kind="specification" aria-pressed="false">Specifications</button></li>
        <li><button type="button" data-kind="convention" aria-pressed="false">Conventions</button></li>
        <li><button type="button" data-kind="manifesto" aria-pressed="false">Manifestos</button></li>
        <li><button type="button" data-kind="principles" aria-pressed="false">Principles</button></li>
        <li><button type="button" data-kind="claimed" aria-pressed="false">Claimed · {claimedCount}</button></li>
      </ul>
      <p class="count" data-count aria-live="polite"></p>
    </section>

    <section data-bundles>
      <h2 id="bundles">Bundles <span class="n">{allBundles.length}</span></h2>
      <ul class="bundles">
        {allBundles.map((b) => (
          <li class="bcard">
            <h3><a href={`/bundles/${b.id}/`}>{b.data.name}</a></h3>
            <p>{b.data.line}</p>
            <span class="n">{b.data.members.length} documents</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="catalog">
      {shelves.map((s) => { const items = entries.filter(s.filter); return items.length ? (
        <div data-group>
          <h2>{s.title} <span class="n">{items.length}</span></h2>
          <ul class="grid">
            {items.map((e) => <DocCard e={e} bundles={bundlesOf(e.id, allBundles)} />)}
          </ul>
        </div>
      ) : null; })}
      <p class="empty" data-empty hidden>No match. <a href="/add/">Add it</a> if it is public.</p>
    </section>
  </main>
  <script type="application/json" id="search-index" set:html={JSON.stringify(index)}></script>
  <script>
    const data = JSON.parse(document.getElementById('search-index')!.textContent || '[]');
    const hay: Record<string, string> = {}; const kind: Record<string, string> = {};
    for (const d of data) { hay[d.s] = [d.n, d.a, d.l, d.k, d.p, d.m, d.t, d.b].join(' ').toLowerCase(); kind[d.s] = d.k; }
    const input = document.getElementById('q') as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-slug]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const bundlesSection = document.querySelector<HTMLElement>('[data-bundles]')!;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filters] button'));
    let activeKind = '';
    function apply() {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const s = c.dataset.slug!;
        const kindOk = !activeKind || (activeKind === 'claimed' ? c.classList.contains('claimed') : kind[s] === activeKind);
        const hit = kindOk && terms.every((t) => hay[s].includes(t));
        c.hidden = !hit; if (hit) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-slug]:not([hidden])');
      const filtering = terms.length > 0 || !!activeKind;
      bundlesSection.hidden = filtering;
      count.textContent = filtering ? `${shown} of ${cards.length}` : '';
      empty.hidden = shown > 0 || !filtering;
      const url = new URL(location.href);
      input.value ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
      activeKind ? url.searchParams.set('kind', activeKind) : url.searchParams.delete('kind');
      history.replaceState(null, '', url);
    }
    input.addEventListener('input', apply);
    document.querySelector('[data-search]')!.addEventListener('submit', (ev) => { ev.preventDefault(); apply(); });
    for (const b of buttons) b.addEventListener('click', () => {
      activeKind = b.dataset.kind || '';
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      apply();
    });
    const u = new URL(location.href);
    const q0 = u.searchParams.get('q'); const k0 = u.searchParams.get('kind');
    if (q0) input.value = q0;
    if (k0) { activeKind = k0; for (const x of buttons) x.setAttribute('aria-pressed', String(x.dataset.kind === k0)); }
    if (q0 || k0) apply();
  </script>
</Base>
