---
import Base from '../layouts/Base.astro';
import { catalog, KIND_LABEL } from '../lib/catalog';
const entries = await catalog();
const groups = [
  { key: 'specs', title: 'Specifications and protocols', blurb: 'Documents that say what a conforming system or tool must do, agent protocols included. Competing specifications sit side by side on purpose.', filter: (e: any) => e.data.kind === 'specification' },
  { key: 'conventions', title: 'File and format conventions', blurb: 'The files a repository or a site publishes so that tools, crawlers and agents know what to expect: each one has a canonical text that says what the file means.', filter: (e: any) => e.data.kind === 'convention' },
  { key: 'companies', title: 'From companies', blurb: 'Principles and manifestos published by businesses about how they build and work. Listed as published; a listing asserts nothing about the company.', filter: (e: any) => !['specification','convention'].includes(e.data.kind) && e.data.publisher === 'company' },
  { key: 'community', title: 'From communities, foundations and individuals', blurb: 'The manifestos and principles the craft stands on, from the Agile Manifesto onward.', filter: (e: any) => !['specification','convention'].includes(e.data.kind) && e.data.publisher !== 'company' },
];
---
<Base title="manifesto.md: the documents projects stand on" description="A directory of manifestos, principles and specifications, each linking to its canonical text, with a badge maintainers can claim.">
  <main id="main" class="wrap">
    <h1>The documents projects stand on.</h1>
    <p class="lede">Manifestos, principles and specifications, one page each, linking to the canonical text and the version it was read against. Maintainers claim their listing; the badge says so. Seven of the specifications are ours; they are listed under the same rules as everyone else's.</p>
    <section id="catalog">
      {groups.map((g) => { const items = entries.filter(g.filter); return items.length ? (
        <>
          <h2>{g.title}</h2>
          <p class="lede">{g.blurb}</p>
          <ul class="grid">
            {items.map((e) => (
              <li class="card">
                <h3><a href={`/${e.id}/`}>{e.data.name}</a></h3>
                <p>{e.data.line}</p>
                <div class="meta">
                  <span class="tag">{KIND_LABEL[e.data.kind]}</span>
                  {e.data.version && <span class="tag">v{e.data.version}</span>}
                  <span class={`tag ${e.data.listing}`}>{e.data.status_of_text === 'unpublished' ? 'text not yet public' : e.data.listing}</span>
                </div>
              </li>
            ))}
          </ul>
        </>
      ) : null; })}
    </section>
    <h2>Add a document, claim a listing</h2>
    <p>Anyone may add a public manifesto, principles page or specification by pull request; the <a href="/add/">add page</a> has the file shape. A maintainer claims a listing by opening the pull request themselves, or by saying yes on the issue we open when we list a document we did not write. Claimed listings carry the badge state <code>claimed</code>; the rest say <code>listed</code>.</p>
  </main>
</Base>
