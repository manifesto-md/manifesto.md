---
import Base from '../layouts/Base.astro';
import DocCard from '../components/DocCard.astro';
import KindIcon from '../components/KindIcon.astro';
import { catalog, bundles, bundlesOf, searchIndex, KIND_LABEL } from '../lib/catalog';
const entries = await catalog();
const allBundles = await bundles();
const index = searchIndex(entries, allBundles);
const kinds = ['specification', 'convention', 'manifesto', 'principles'];
const countOf = (k: string) => entries.filter((e) => e.data.kind === k).length;
const claimedCount = entries.filter((e) => e.data.listing === 'claimed').length;
const bundleData = Object.fromEntries(allBundles.map((b) => [b.id, { name: b.data.name, line: b.data.line, members: b.data.members }]));
---
<Base title="manifesto.md: the documents projects stand on" description={`${entries.length} manifestos, principles, specifications and conventions, each linking to its canonical text.`}>
  <main id="main" class="wrap two">
    <aside class="rail">
      <h1>The documents projects stand on.</h1>
      <p class="sub">{entries.length} documents, canonical text and version for each.</p>
      <form class="search" role="search" action="/" data-search>
        <label class="sr" for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="Search" autocomplete="off" />
      </form>
      <nav class="facet" aria-label="Kind" data-kinds>
        <h2>Kind</h2>
        <button type="button" data-kind="" aria-pressed="true"><span>All</span><span class="n">{entries.length}</span></button>
        {kinds.map((k) => <button type="button" data-kind={k} aria-pressed="false"><span><KindIcon kind={k} size={14} decorative /> {KIND_LABEL[k]}s</span><span class="n">{countOf(k)}</span></button>)}
        <button type="button" data-kind="claimed" aria-pressed="false"><span><span class="claim"></span> Claimed</span><span class="n">{claimedCount}</span></button>
      </nav>
      <nav class="facet" aria-label="Bundles" data-bundlenav>
        <h2>Bundles</h2>
        {allBundles.map((b) => <button type="button" data-bundle={b.id} aria-pressed="false"><span>{b.data.name}</span><span class="n">{b.data.members.length}</span></button>)}
      </nav>
      <p class="count" data-count aria-live="polite"></p>
    </aside>
    <section class="pane" id="catalog">
      <div class="bundlehead" data-bundlehead hidden>
        <h2 data-bundlename></h2>
        <p data-bundleline></p>
        <a data-bundlelink href="/bundles/">Bundle page</a>
      </div>
      <ul class="grid" data-grid>
        {entries.map((e) => <DocCard e={e} bundles={bundlesOf(e.id, allBundles)} />)}
      </ul>
      <p class="empty" data-empty hidden>No match. <a href="/add/">Add it</a> if it is public.</p>
    </section>
  </main>
  <script type="application/json" id="search-index" set:html={JSON.stringify(index)}></script>
  <script type="application/json" id="bundle-data" set:html={JSON.stringify(bundleData)}></script>
  <script>
    const data = JSON.parse(document.getElementById('search-index')!.textContent || '[]');
    const bundleData = JSON.parse(document.getElementById('bundle-data')!.textContent || '{}');
    const hay: Record<string, string> = {};
    for (const d of data) hay[d.s] = [d.n, d.a, d.l, d.k, d.p, d.m, d.t, d.b].join(' ').toLowerCase();
    const input = document.getElementById('q') as HTMLInputElement;
    const grid = document.querySelector<HTMLElement>('[data-grid]')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-slug]'));
    const original = cards.slice();
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const head = document.querySelector<HTMLElement>('[data-bundlehead]')!;
    const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kinds] button'));
    const bundleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bundlenav] button'));
    let kind = '', bundle = '';
    function order() {
      const list = bundle ? [...bundleData[bundle].members.map((m: string) => cards.find((c) => c.dataset.slug === m)!).filter(Boolean), ...original.filter((c) => !bundleData[bundle].members.includes(c.dataset.slug!))] : original;
      for (const c of list) grid.appendChild(c);
    }
    function apply() {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const s = c.dataset.slug!;
        const kindOk = !kind || (kind === 'claimed' ? c.classList.contains('claimed') : c.dataset.kind === kind);
        const bundleOk = !bundle || bundleData[bundle].members.includes(s);
        const hit = kindOk && bundleOk && terms.every((t) => hay[s].includes(t));
        c.hidden = !hit; if (hit) shown++;
      }
      order();
      const filtering = terms.length > 0 || !!kind || !!bundle;
      count.textContent = filtering ? `${shown} of ${cards.length}` : '';
      empty.hidden = shown > 0 || !filtering;
      head.hidden = !bundle;
      if (bundle) {
        head.querySelector('[data-bundlename]')!.textContent = bundleData[bundle].name;
        head.querySelector('[data-bundleline]')!.textContent = bundleData[bundle].line;
        (head.querySelector('[data-bundlelink]') as HTMLAnchorElement).href = `/bundles/${bundle}/`;
      }
      for (const b of kindButtons) b.setAttribute('aria-pressed', String((b.dataset.kind || '') === kind));
      for (const b of bundleButtons) b.setAttribute('aria-pressed', String(b.dataset.bundle === bundle));
      const url = new URL(location.href);
      for (const [k, v] of [['q', input.value], ['kind', kind], ['bundle', bundle]] as const) v ? url.searchParams.set(k, v) : url.searchParams.delete(k);
      history.replaceState(null, '', url);
    }
    input.addEventListener('input', apply);
    document.querySelector('[data-search]')!.addEventListener('submit', (ev) => { ev.preventDefault(); apply(); });
    for (const b of kindButtons) b.addEventListener('click', () => { kind = b.dataset.kind || ''; apply(); });
    for (const b of bundleButtons) b.addEventListener('click', () => { bundle = bundle === b.dataset.bundle ? '' : b.dataset.bundle!; apply(); });
    const u = new URL(location.href);
    input.value = u.searchParams.get('q') || ''; kind = u.searchParams.get('kind') || ''; bundle = u.searchParams.get('bundle') || '';
    if (!bundleData[bundle]) bundle = '';
    apply();
  </script>
</Base>
