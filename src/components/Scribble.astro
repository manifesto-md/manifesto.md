---
// Hand-drawn marks in red pencil: deterministic wobble from a seed so the same page renders the same way.
interface Props { kind: 'underline' | 'circle' | 'arrow' | 'tick'; seed?: string; class?: string; width?: number; height?: number }
const { kind, seed = 'x', class: cls = '', width, height } = Astro.props;
let h = 0; for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const r = (n: number, span = 1) => ((((h >> (n * 3)) & 15) / 15) - 0.5) * span; // -span/2 .. span/2
const paths: Record<string, { w: number; h: number; d: string }> = {
  underline: { w: 200, h: 14, d: `M2,${8 + r(1, 3)} C 40,${3 + r(2, 4)} 90,${12 + r(3, 4)} 130,${7 + r(4, 3)} S 185,${4 + r(5, 4)} 198,${9 + r(6, 3)}` },
  circle: { w: 60, h: 36, d: `M${30 + r(1, 4)},${4 + r(2, 2)} C ${50 + r(3, 4)},2 ${60 + r(4, 3)},${14 + r(5, 4)} ${52 + r(6, 4)},${26 + r(7, 3)} S ${22 + r(8, 5)},${36 + r(1, 2)} ${8 + r(2, 4)},${22 + r(3, 4)} S ${12 + r(4, 4)},${2 + r(5, 2)} ${34 + r(6, 4)},${5 + r(7, 2)}` },
  arrow: { w: 70, h: 30, d: `M2,${22 + r(1, 4)} C 20,${20 + r(2, 6)} 40,${8 + r(3, 6)} 64,${10 + r(4, 4)} M56,${4 + r(5, 2)} L65,${10 + r(4, 4)} L55,${16 + r(6, 3)}` },
  tick: { w: 26, h: 22, d: `M3,${12 + r(1, 3)} C 8,${15 + r(2, 3)} 10,${19 + r(3, 2)} 11,${19 + r(3, 2)} C 14,${12 + r(4, 3)} 19,${5 + r(5, 3)} 24,${2 + r(6, 2)}` },
};
const p = paths[kind];
---
<svg class={`scribble ${kind} ${cls}`} viewBox={`0 0 ${p.w} ${p.h}`} width={width ?? p.w} height={height ?? p.h} aria-hidden="true" preserveAspectRatio="none"><path d={p.d} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
<style>
  .scribble { color: var(--pencil); display: inline-block; vertical-align: middle; overflow: visible; }
</style>
